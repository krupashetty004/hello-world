import torch 
from google.colab import userdata 
hf_token = userdata.get("HF_TOKEN") 
pipeline = StableDiffusionPipeline.from_pretrained( 
"runwayml/stable-diffusion-v1-5",  
torch_dtype=torch.float16, 
token=hf_token  
) 
pipeline.to("cuda")  
def generate_and_save_image(prompt, negative_prompt, guidance_scale, filename): 
"""Generates an image with given parameters and saves it.""" 
negative_prompt = negative_prompt if negative_prompt is not None else "" 
image = pipeline( 
prompt=prompt, 
negative_prompt=negative_prompt, 
guidance_scale=guidance_scale 
).images[0] 
image.save(filename) 
print(f"Image saved as {filename}") 
prompt_basic = "A majestic dragon flying over a medieval castle" 
generate_and_save_image(prompt_basic, None, 7.5, "dragon_basic.png") 
prompt_negative = "A majestic dragon flying over a medieval castle" 
negative_prompt_example = "blurry, low quality, distorted, ugly, bad anatomy" 
generate_and_save_image(prompt_negative, negative_prompt_example, 7.5, "dragon_negative_prompt.png") 
generate_and_save_image(prompt_basic, None, 4.0, "dragon_cfg_low.png") 
generate_and_save_image(prompt_basic, None, 12.0, "dragon_cfg_high.png") 
prompt_detailed = "A highly detailed, photorealistic image of a majestic red dragon with scales shimmering in 
the sunlight, soaring above a grand, ancient medieval castle at sunset, volumetric lighting, epic fantasy art, 
8k" 
negative_prompt_detailed = "cartoon, drawing, low resolution, amateur, poorly rendered" 
generate_and_save_image(prompt_detailed, negative_prompt_detailed, 9.0, "dragon_detailed.png") 
