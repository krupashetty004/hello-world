8. Positional Encoding-Implement a python code to do positional encoding in GPT.  
import numpy as np 
def positional_encoding(seq_len,embed_dim,div_term=10000): 
positions=np.arange(seq_len)[:,np.newaxis] 
div_term_exp=np.arange(0,embed_dim,2)/embed_dim 
angles=positions/(div_term**div_term_exp) 
pos_enc=np.zeros((seq_len,embed_dim)) 
pos_enc[:,0::2]=np.sin(angles) 
pos_enc[:,0::2]=np.cos(angles) 
return pos_enc 
