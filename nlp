2. Meaning Representation- Implement a Python program to represent the meaning of the given text.  
import nltk 
nltk.download(['punkt', 'averaged_perceptron_tagger'], quiet=True) 
def represent_meaning(text): 
tokens = nltk.word_tokenize(text) 
tags = nltk.pos_tag(tokens) 
meaning = {} 
for word, tag in tags: 
if tag.startswith('VB'): meaning['action'] = word 
elif tag.startswith('JJ'): meaning['desc'] = word 
elif tag.startswith('NN'): 
meaning['object' if 'subject' in meaning else 'subject'] = word 
return meaning 
sentence = "The quick cat chased the mouse" 
print(f"Sentence: {sentence}\nMeaning: {represent_meaning(sentence)}") 
3. Disambiguity- Design the lesk algorithm in Python to handle word sense disambiguation.  
import nltk 
from nltk.corpus import wordnet as wn 
from nltk.tokenize import word_tokenize 
def lesk_algorithm(word, sentence): 
tokens = set(word_tokenize(sentence)) 
synsets = wn.synsets(word) 
if not synsets: return None 
def get_overlap(sense): 
gloss = set(word_tokenize(sense.definition())) 
return len(tokens & gloss) 
return max(synsets, key=get_overlap) 
# Usage 
sentence = "I went to the bank to deposit my money." 
word = "bank" 
res = lesk_algorithm(word, sentence) 
if res: 
print(f"Sense: {res.name()}\nDef: {res.definition()}") 
