import os 
from mistralai.client import Mistral 
from langchain_core.documents import Document 
from langchain_text_splitters import RecursiveCharacterTextSplitter 
from langchain_community.embeddings import HuggingFaceEmbeddings 
from langchain_community.vectorstores import FAISS 
os.environ["MISTRAL_API_KEY"] = "YundpHsObqBneafJZ4jtU1p7B2GMFHSu" 
client = Mistral(api_key=os.environ["MISTRAL_API_KEY"]) 
text = """Artificial Intelligence (AI) is a field of computer science 
that focuses on creating systems capable of performing tasks that 
typically require human intelligence such as learning, reasoning, and problem-solving.""" 
documents = [Document(page_content=text)] 
splitter = RecursiveCharacterTextSplitter(chunk_size=200, chunk_overlap=50) 
docs = splitter.split_documents(documents) 
embeddings = HuggingFaceEmbeddings() 
vector_db = FAISS.from_documents(docs, embeddings) 
query = "What is Artificial Intelligence?" 
retrieved_docs = vector_db.similarity_search(query) 
context = " ".join([doc.page_content for doc in retrieved_docs]) 
prompt = f""" 
Answer based only on the context below. 
Context: {context} 
Question: {query} 
Answer: 
""" 
response = client.chat.complete( 
model="mistral-large-latest", 
messages=[{"role": "user", "content": prompt}] 
) 
print("Answer:", response.choices[0].message.content) 
